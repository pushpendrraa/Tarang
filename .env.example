# ─── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/tracenet

# ─── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ─── File Upload ─────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# ─── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Client URL (for CORS) ───────────────────────────────────────────
CLIENT_URL=http://localhost:5173
